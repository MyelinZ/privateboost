# The TikZ figures are built in place by latexmk. The figure directory sits under
# manuscript/ here and at the top level in the published artifact, so both paths
# are listed; each matches only in the tree that has it.
/manuscript/figures/*.aux
/manuscript/figures/*.fdb_latexmk
/manuscript/figures/*.fls
/manuscript/figures/*.log
/figures/*.aux
/figures/*.fdb_latexmk
/figures/*.fls
/figures/*.log

# export_source_data.py's workbooks. They are committed under
# manuscript/supplementary/ here; in the published artifact, which carries no
# manuscript/, they are regenerable output that ships with nothing to compare
# against, so only the top-level path is ignored.
/supplementary/

/deploy/local/state/
/deploy/emulator/state/

